{
  "name": "hanzi-cards",
  "description": "Offline Chinese-English flashcards with handwriting practice",
  "license": "MIT",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.31",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "react-native-svg": "15.15.4",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "hanzi-writer-data": "2.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepare:data": "node scripts/prepare-data.mjs",
    "export:mobile": "expo export --platform android --platform ios"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/awesomesibyll-glitch/hanzi-cards.git"
  }
}
